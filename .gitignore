# 本机部署与 E2E 产物（配置、凭据、证书、日志、报告）
/local/

# 环境配置与凭据；保留可提交的示例配置
.env
.env.*
!.env.example
!.env.*.example
/config/*.local.yaml
*.log
*.pid
*.key
*.p12
*.pfx

# 操作系统及编辑器临时文件
.DS_Store
._*
Thumbs.db
Desktop.ini
.idea/
.vscode/
.kiro/
*.swp
*.swo
*~

# 工具生成的计划与工作目录（任意层级，包括 docs/superpowers/）
superpowers/
.superpowers/

# Python 环境、缓存及测试产物
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# 本机工具输出（仅根目录，避免误忽略测试夹具中的同名目录）
/bin/
/.cache/
