[Unit]
Description=TailBridge DERP relay
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=derper
Group=derper
ExecStart=/usr/local/bin/derper -hostname=${DERP_HOSTNAME} -a=:${DERP_PORT} -http-port=-1 -stun=true -stun-port=3478 -certmode=manual "-certdir=${DERP_CERT_DIR}" -c=/var/lib/derper/derper.key -verify-client-url=${SERVER_URL}/verify -verify-client-url-fail-open=false
StateDirectory=derper
StateDirectoryMode=0700
UMask=0077
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
